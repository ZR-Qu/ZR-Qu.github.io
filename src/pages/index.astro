---
import { Image } from 'astro:assets'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import ProjectList from '@/components/projects/ProjectList.astro'
import { selectedProjects } from '@/data/projects'
import config from '@/site-config'

const MAX_POSTS = 5
const posts = sortMDByDate(await getBlogCollection()).slice(0, MAX_POSTS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section
      id='content-header'
      class='animate mb-10 flex w-full max-w-3xl items-center gap-5 sm:gap-7'
    >
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'ZR-Qu'}
        class='size-24 shrink-0 rounded-full border p-1 sm:size-28'
        loading='eager'
        fetchpriority='high'
      />
      <div class='min-w-0'>
        <h1 class='text-3xl font-medium tracking-tight'>{config.author}</h1>
        <p class='mt-1 text-muted-foreground'>Information Security @ HUST CSE</p>
        <p class='mt-2 text-sm leading-6 text-muted-foreground'>
          Systems Security · Trusted Computing · AI Systems
        </p>
        <div class='mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm'>
          <a href='https://github.com/ZR-Qu' target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
          <a href='mailto:ziruiqu@hust.edu.cn'>Email</a>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex w-full max-w-3xl flex-col gap-y-10'>
      <Section title='About me'>
        <p class='leading-7 text-muted-foreground'>
          Information Security undergraduate at HUST's School of Cyber Science and Engineering,
          interested in systems security, trusted computing, heterogeneous computing, and AI
          systems.
        </p>
        <a class='w-fit self-end' href='/about'>More about me →</a>
      </Section>

      <Section title='Selected Projects'>
        <ProjectList projects={selectedProjects} />
        <a class='w-fit self-end' href='/projects'>More projects →</a>
      </Section>

      {
        posts.length > 0 && (
          <Section title='Recent Posts'>
            <div class='flex flex-col divide-y'>
              {posts.map((post) => (
                <a
                  class='grid gap-x-4 gap-y-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-baseline'
                  href={`/blog/${post.id}`}
                  data-astro-prefetch
                >
                  <time class='text-sm text-muted-foreground'>
                    {post.data.publishDate
                      ? post.data.publishDate.toISOString().slice(0, 10)
                      : ''}
                  </time>
                  <span class='min-w-0 font-medium hover:text-primary'>{post.data.title}</span>
                  {post.data.tags.length > 0 && (
                    <ul class='flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground sm:col-start-2'>
                      {post.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )}
                </a>
              ))}
            </div>
            <a class='w-fit self-end' href='/blog'>All posts →</a>
          </Section>
        )
      }
    </div>
  </main>
</PageLayout>

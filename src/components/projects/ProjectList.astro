---
import type { SiteProject } from '@/data/projects'

interface Props {
  projects: SiteProject[]
}

const { projects } = Astro.props
---

<div class='not-prose flex flex-col divide-y'>
  {
    projects.map((project) => (
      <article class='grid gap-x-4 gap-y-2 py-4 first:pt-0 last:pb-0 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start'>
        <div class='min-w-0'>
          <div class='flex flex-wrap items-baseline gap-x-3 gap-y-1'>
            {project.href ? (
              <a
                class='font-medium text-foreground underline-offset-4 hover:text-primary hover:underline'
                href={project.href}
                target='_blank'
                rel='noopener noreferrer'
              >
                {project.name}
              </a>
            ) : (
              <span class='font-medium'>{project.name}</span>
            )}
            <time class='text-sm text-muted-foreground'>{project.year}</time>
          </div>
          <p class='mt-1 text-sm leading-6 text-muted-foreground'>{project.description}</p>
          <ul class='mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground'>
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          {
            project.related?.length && (
              <div class='mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs'>
                <span class='text-muted-foreground'>Related:</span>
                {project.related.map((link) => (
                  <a href={link.href} target='_blank' rel='noopener noreferrer'>
                    {link.label} ↗
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </article>
    ))
  }
</div>
